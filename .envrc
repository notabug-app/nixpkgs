if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  current_branch="$(git branch --show-current 2>/dev/null || true)"
  if [ "$current_branch" != "staging" ]; then
    log_status "switching branch to staging"
    if git show-ref --verify --quiet refs/heads/staging; then
      git checkout staging || log_status "failed switching to staging"
    elif git rev-parse --verify origin/staging >/dev/null 2>&1; then
      git checkout -b staging --track origin/staging || log_status "failed creating staging tracking branch"
    fi
  fi

  current_branch="$(git branch --show-current 2>/dev/null || true)"
  if [ "$current_branch" = "staging" ]; then
    log_status "pulling latest changes from origin/staging"
    git pull --ff-only --no-rebase origin staging || log_status "failed pulling origin/staging"
  fi
fi

use flake
